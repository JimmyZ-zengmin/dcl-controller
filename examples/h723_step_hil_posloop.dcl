# h723_step_hil_posloop.dcl — ★★★ **HIL 位置环**：虚拟环境当"绝对位置传感器"
#
# ══════════════════════════════════════════════════════════════════════════
# 这个程序要做的事（用户 2026-09-22 的构想）
# ══════════════════════════════════════════════════════════════════════════
# 用户的判断：**"把虚拟环境当作一个位置传感器返回到板子 ⇒ 就能做位置环。
#               虚拟环境负责绝对位置坐标系，电机相当于半个在世界。"**
#   ★ 这个判断**在架构上是对的** —— HIL 本来就该是双向的。
#   ★ 而它绕过的正是本项目最硬的那道边界：**AS5600 是单圈绝对编码器**
#     ⇒ `sensor[1]` 只在 0..360 有意义 ⇒ ③ 层**拿不到多圈位置**
#     （详见 `h723_step_screw_recip.dcl` 的说明）。
#   ⇒ **PC 侧累计出绝对位置（它已经在做：`bridge.py` 的 `WAVEBUF`），再写回板子** ⇒
#     ③ 层就"看得见"任意长的行程了。
#
# ══════════════════════════════════════════════════════════════════════════
# ★★★ 通道的选择（为什么不写 SENSOR、为什么是 wire[50]）
# ══════════════════════════════════════════════════════════════════════════
#   · **不写 `SENSOR[]`**：`SENSOR[0..10]` 全都有写者（0/1=AS5600 · 2=HIL 反馈 ·
#     3..6=DI · 8..10=AI，见 `as5600.c` / `hil.c` / `di.c` / `adc.c`）。
#     PC 再写同一个槽 = **两个写者** ⇒ 违反单写者纪律（本项目已两次踩到：TIM3、SD 卡）。
#   · **用 `wire[50]`**：`wire[0..15]` 是与上位机的 HMI 约定（本例用了 10）；
#     `wire[64..]` 是固件保留（64/65 是运动镜像）；`wire[16..63]` 空着。
#     ★ 取 50 是为了**远离 dclc 的自动分配区**（实测中间量落在 17~2x）。
#
# ══════════════════════════════════════════════════════════════════════════
# ★★★★ 必须说清的代价：这条位置环的带宽 ≈ **PC 更新率（~10 Hz）**，不是 100 µs
# ══════════════════════════════════════════════════════════════════════════
#   · ③ 层程序**每拍（100 µs）**跑，但 `wire[50]` 只由 PC 约**每 100 ms**更新一次
#     （协议往返固定开销 ~10 ms + 每次应答 ~30 ms ⇒ 实测 bridge 轮询 ~10~16 Hz）
#   · ⇒ 在这 100 ms 内，程序看到的位置是**冻结的**，而它仍按 `kp×|err|` 推频率
#     ⇒ **等效"每 100 ms 才闭环一次"** ⇒
#        · 闭环带宽上限 ≈ **5 Hz**（奈奎斯特的一半）
#        · 而且**容易过冲/振荡**（100 ms 的开环推进 + 轮到下一个 100 ms 才纠偏）
#   ⇒ ★★ **它验证的是"位置域算法与总线闭环的逻辑"，不是"实时位置环的性能"。**
#      真正的实时位置环需要**板内**的多圈绝对位置（多圈编码器，或主循环里累加 `Δraw`）。
#   ★ 这也正是"外挂 PC 做控制"的固有代价 —— 与审计 §9.1 那条
#     "PC 在环 13.5 Hz / 滞后 ~80 ms vs 片内 100 µs（差 ~700 倍）"是同一件事。
#
# ══════════════════════════════════════════════════════════════════════════
# 接口
# ══════════════════════════════════════════════════════════════════════════
#   wire[10]  = 使能 (>0.5)                        ← PC 写
#   wire[50]  = **虚拟绝对位置 (mm)**               ← ★★ PC 写（HIL 的反向通道）
#   wire[30]  = SEQ 段号（程序内部）
#   wire[12..15] = 运动请求（程序面输出）
#   wire[56..59] = 观测：段号 / 目标 / 虚拟位置 / 误差
#
# 部署（三步，少一个就"程序在跑、硬件不动"）:
#   python tools/dclc.py examples/h723_step_hil_posloop.dcl
#   python tools/h723_as5600_bind.py           # ★ 部署后必做
#   # 0x39 op=19 sub=13 arg=1（切程序面）+ sub=17 6000（斜坡）
# ══════════════════════════════════════════════════════════════════════════

CONST   kp      = 8.0           # Hz per mm（★ 60 mm 误差 ⇒ 480 Hz；钳位后到 3000）
CONST   band    = 0.5           # 误差带 (mm)：|err| ≤ band ⇒ 停（到位自停，不抖动）
CONST   lim_ms  = 0.0           # 0 = 不限时
CONST   one     = 1.0
CONST   fwd     = 0.0           # 实测 dir=0 ⇒ 角度增大（= 位置增大）
CONST   rev     = 1.0
CONST   mone    = -1.0
CONST   P0      = 0.0           # 目标①：0 mm
CONST   P1      = 60.0          # 目标②：60 mm
CONST   P2      = 120.0         # 目标③：120 mm

# ── 目标：3 段 SEQ ⇒ 链式 SEL。
#    ★ `SEQ` 步号 **1 起**（固件 engine.c:474 `out_wire = step_cur + 1`）
#      ⇒ 门限是 1.5 / 2.5，不是 0.5 / 1.5（按 0 起写会**恒真** ⇒ 目标永远停在最后一档）──
GE      s2      IN=wire[30] THR=1.5
GE      s3      IN=wire[30] THR=2.5
SEL     t1      G=s2 IN0=P0 IN1=P1      # 段1 ⇒ P0；段≥2 ⇒ P1
SEL     tgt     G=s3 IN0=t1 IN1=P2      # 段3 ⇒ P2

# ── 误差 = 目标 − **虚拟绝对位置**（PC 经 wire[50] 送来）──
SUB     err     FROM tgt BY=wire[50]

# ── |err|：DCL 没有 ABS ⇒ 用 MAX(err, −err) 表达（既有范式）──
MUL     eneg    FROM err BY=mone
MAX     eab     FROM err BY=eneg

# ── 幅值 = kp × |err|，再钳到 [60, 3000]。
#    ★ 下限 60 Hz 而不是 TIM3 的 15 Hz：15 Hz 下电机 3.4°/s **看着像"不转"**，
#      而且会让"该反向"被下限**翻转成正向** ⇒ 发散（`bounded_position.dcl` 的教训）──
MUL     raw     FROM eab BY=kp
LIMIT   hz0     IN=raw MN=60.0 MX=3000.0

# ── 误差带自停：带内 ⇒ 0（绝不"微小抖动持续通电"）──
GE      drv     IN=eab THR=band
MUL     hz      FROM hz0 BY=drv

# ── 方向 = 误差符号：err ≥ 0 ⇒ dir=0（位置增大）；err < 0 ⇒ dir=1 ──
GE      dpos    IN=err THR=0.0
LOGIC   dneg    = NOT dpos

# ── 使能门（PC 写 wire[10]）──
GE      ena     IN=wire[10] THR=0.5
MUL     hzf     FROM hz BY=ena

# ── 运动请求（③层写 wire[12..15]）──
OUTPUT  o_hz    TO wire[12] FROM hzf
OUTPUT  o_dir   TO wire[13] FROM dneg
OUTPUT  o_ena   TO wire[14] FROM one
OUTPUT  o_lim   TO wire[15] FROM lim_ms

# ── 观测（回读判断"环路在不在转、错差多大"）──
OUTPUT  w_seg   TO wire[56] FROM wire[30]
OUTPUT  w_tgt   TO wire[57] FROM tgt
OUTPUT  w_vpos  TO wire[58] FROM wire[50]
OUTPUT  w_err   TO wire[59] FROM err

# ── 顺序域（**必须文件末尾**）：3 段 × 3 s = 9 s 循环 ──
SEQ     prof    TO wire[30] PERIOD=10ms
  DWELL 3000ms
  DWELL 3000ms
  DWELL 3000ms
  LOOP
