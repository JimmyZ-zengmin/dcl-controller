# h723_step_traj_sine.dcl — ★★★ 轨迹规划②：**正弦速度曲线（阶梯表逼近）**
#
# ══════════════════════════════════════════════════════════════════════════
# 为什么是"阶梯表"而不是"解析正弦"
# ══════════════════════════════════════════════════════════════════════════
# ① ★★★ **引擎有 `LUT` 原语（`prim_lut`，还带线性插值），但 `dclc.py` 没有暴露它**
#    ⇒ ③ 层**写不出查表**。这是**工具链缺口**，不是能力缺口（登记在下方"待补"）。
# ② 所以正弦只能走**阶梯表**：把半周期切成 N 段、每段给一个正弦采样值。
#    ★ 这**不是退而求其次** —— 工业运动控制里的"正弦/S 曲线加减速"本来就是**分段实现**
#      （控制器按段改目标加速度/速度），段数够多就成了正弦。
# ③ ★ 形状由**谁来平滑**？`SEQ` 给阶梯、**固件斜坡**把台阶爬成斜坡 ——
#    `sub=17 slope = 0` ⇒ 保留**阶梯形状**（便于验证"表是对的"）；
#    `slope > 0` ⇒ 台阶被爬平，更接近连续正弦（便于做平滑运动）。
#    ★ 验证时**两种都测**：先 `slope=0` 量"表对不对"（形状判据），再开斜坡量"平滑后"。
#
# ══════════════════════════════════════════════════════════════════════════
# 表：半正弦脉冲（单向），6 段，归一化因子 = sin(π·(k+0.5)/6)
# ══════════════════════════════════════════════════════════════════════════
#   段 k :  0      1      2      3      4      5
#   sin  : 0.259  0.707  0.966  0.966  0.707  0.259     ← sin(π·(k+0.5)/6)
#   ★ 段 2/3 取 0.966（而非 1.0）：让"峰"落在两段之间 —— 与"从 0 起、到 0 止"的
#     半正弦对称，且**峰值可预测**（峰值 = 0.966·A）。
#
# 接口
#   wire[11] = 峰值频率 A (Hz)   wire[10] = 使能 (>0.5)
#   wire[56] = 段号  wire[57] = 目标  wire[58] = 实际下发频率
# ★ 部署后必须 `python tools/h723_as5600_bind.py`；再 `0x39 op=19 sub=13 arg=1`
# ══════════════════════════════════════════════════════════════════════════

CONST   K1      = 0.259
CONST   K2      = 0.707
CONST   K3      = 0.966
CONST   lim_ms  = 0.0
CONST   dirfwd  = 0.0

# ── 段号 → 归一化因子（阶梯表；`SEL` 按 G>0.5 取 IN1 ⇒ 链式"逐段抬升"）──
#   ★★★ **`SEQ` 步号 1 起**（固件 `engine.c:474`: `out_wire = step_cur + 1`, "与第几步人眼一致"）
#     ⇒ 6 段的门限是 **1.5/2.5/3.5/4.5/5.5**，不是 0.5/1.5/2.5/3.5/4.5。
#     （三角波那版就是按 0 起写错、导致"轴完全不动"—— 已修。）
GE      s1      IN=wire[30] THR=1.5
GE      s2      IN=wire[30] THR=2.5
GE      s3      IN=wire[30] THR=3.5
GE      s4      IN=wire[30] THR=4.5
GE      s5      IN=wire[30] THR=5.5
SEL     t0      G=s1 IN0=K1 IN1=K2
SEL     t1      G=s2 IN0=t0 IN1=K3
SEL     t2      G=s3 IN0=t1 IN1=K3
SEL     t3      G=s4 IN0=t2 IN1=K2
SEL     t4      G=s5 IN0=t3 IN1=K1

# ── 因子 × A ⇒ 目标频率；再过使能门 ──
MUL     tgt     FROM wire[11] BY=t4
GE      ena     IN=wire[10] THR=0.5
MUL     hz      FROM tgt BY=ena

# ── 运动请求 ──
OUTPUT  o_hz    TO wire[12] FROM hz
OUTPUT  o_dir   TO wire[13] FROM dirfwd
OUTPUT  o_ena   TO wire[14] FROM wire[10]
OUTPUT  o_lim   TO wire[15] FROM lim_ms

# ── 观测 ──
OUTPUT  w_seg   TO wire[56] FROM wire[30]
OUTPUT  w_tgt   TO wire[57] FROM tgt
OUTPUT  w_hz    TO wire[58] FROM hz

# ── 顺序域（**必须文件末尾**）：6 段 × 100ms = 600ms 一个半正弦脉冲 ──
SEQ     prof    TO wire[30] PERIOD=10ms
  DWELL 250ms
  DWELL 250ms
  DWELL 250ms
  DWELL 250ms
  DWELL 250ms
  DWELL 250ms
  LOOP
