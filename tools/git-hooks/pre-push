#!/bin/sh
# pre-push —— 拦截误推 dcl-controller（对外发布仓）
#
# 背景：本项目 `remote.pushdefault` 曾是 dcl，而两个远端的语义不同：
#   · origin = H723PLC        = **私人开发仓** → 日常开发推这里（含记忆/台账）
#   · dcl    = dcl-controller = **对外发布仓** → 只发布**过滤后的公开树**
#
# ★★ 2026-09-19 收紧（用户要求）：**禁止直推 dcl**。
#   为什么：直推是"整树推送"，会把 `.workbuddy/`（记忆 · 撤回台账 P1~P33 · 逐日复盘）
#   与 `.tmpctl/` 一起送到公开面上。
#   ⇒ 唯一入口是 `tools/dcl_publish.sh`：它用**临时索引**过滤出公开树（白名单路径），
#     只推那些路径。它推送时设 `DCL_FROM_PUBLISH_SCRIPT=1`，本钩子据此放行。
#
# 日常开发：  bash tools/h723_push.sh
# 发布对外：  bash tools/dcl_publish.sh --dry-run   # 先看清单
#             bash tools/dcl_publish.sh             # 真发布（fast-forward）
remote_name="$1"
remote_url="$2"

case "$remote_name $remote_url" in
  *dcl-controller*)
    if [ "${DCL_FROM_PUBLISH_SCRIPT:-0}" = "1" ]; then
      echo "ℹ️  来自 tools/dcl_publish.sh 的发布推送 —— 允许（公开树已过滤）" >&2
    else
      echo "✗ pre-push 拦截：禁止**直推** dcl-controller（对外发布仓）。" >&2
      echo "  为什么：直推是整树推送，会把 .workbuddy/（记忆·撤回台账）带进公开仓。" >&2
      echo "  正确做法：bash tools/dcl_publish.sh            # 过滤后发布（fast-forward）" >&2
      echo "            bash tools/dcl_publish.sh --dry-run  # 先看会发布哪些文件" >&2
      echo "  日常开发：bash tools/h723_push.sh              # 只推 H723PLC（含记忆）" >&2
      exit 1
    fi
    ;;
esac
exit 0
